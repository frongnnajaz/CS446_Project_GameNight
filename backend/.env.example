# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง
# ฐานข้อมูล PostgreSQL (ค่าด้านล่างคือ Prisma Postgres ในเครื่อง ที่เปิดด้วย npm run db:start)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# จำนวน connection สูงสุด (prisma dev ในเครื่องต้องเป็น 1, PostgreSQL จริงใช้ 10 ได้)
DB_POOL_MAX=1

# พอร์ตของ Backend API
API_PORT=3000

# โดเมนของ Frontend ที่อนุญาตให้เรียก API (คั่นด้วย , เว้นว่าง = อนุญาตทุกโดเมน)
# CORS_ORIGIN=http://localhost:5173
